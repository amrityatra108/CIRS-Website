# CI installs html-validate here; it is never committed.
node_modules/
package-lock.json

# The content editor is parked: built on demand with
# 'tools/build-bundles.py --editor', never committed. See HOSTING.md.
cirs-editor.html

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp

# Staged deploy output, built by tools/stage-deploy.py
_site/

# Deployment credentials and licensed fonts stay outside this public repo.
.vercel/
.env
.env*.local
assets/fonts/[Bb]rier*.woff2
assets/fonts/licenses/[Bb]rier*

# Netlify CLI local link state
.netlify/
__pycache__/

# Alumni Registration Form exports hold phone numbers, emails and dates of
# birth. tools/make-alumni-register.py reads one; only its output is committed.
*.xlsx
