{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 tools/build-site.py && python3 tools/stage-deploy.py --vercel",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/student-life", "destination": "/the-cirs-experience", "permanent": true },
    { "source": "/student-life.html", "destination": "/the-cirs-experience", "permanent": true },
    { "source": "/creative-writing/junior/july-2026", "destination": "/creative-writing/junior", "permanent": true },
    { "source": "/creative-writing/junior/july-2026.html", "destination": "/creative-writing/junior", "permanent": true },
    { "source": "/creative-writing/junior/august-2026", "destination": "/creative-writing/junior", "permanent": true },
    { "source": "/creative-writing/junior/august-2026.html", "destination": "/creative-writing/junior", "permanent": true },
    { "source": "/creative-writing/junior/september-2026", "destination": "/creative-writing/junior", "permanent": true },
    { "source": "/creative-writing/junior/september-2026.html", "destination": "/creative-writing/junior", "permanent": true },
    { "source": "/creative-writing/senior/july-2026", "destination": "/creative-writing/senior", "permanent": true },
    { "source": "/creative-writing/senior/july-2026.html", "destination": "/creative-writing/senior", "permanent": true },
    { "source": "/creative-writing/senior/august-2026", "destination": "/creative-writing/senior", "permanent": true },
    { "source": "/creative-writing/senior/august-2026.html", "destination": "/creative-writing/senior", "permanent": true },
    { "source": "/creative-writing/senior/september-2026", "destination": "/creative-writing/senior", "permanent": true },
    { "source": "/creative-writing/senior/september-2026.html", "destination": "/creative-writing/senior", "permanent": true },
    { "source": "/assets/founder-opening", "destination": "/founder", "permanent": true },
    { "source": "/assets/founder-opening/index.html", "destination": "/founder", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
