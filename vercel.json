{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 tools/build-site.py && python3 tools/stage-deploy.py",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "redirects": [
    { "source": "/admissions/", "destination": "/admissions", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
